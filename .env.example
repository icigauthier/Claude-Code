# Variables d'environnement du CRM en ligne.
# Ne mets PAS de vraies valeurs dans ce fichier — c'est un simple exemple.
# En ligne, ces valeurs se saisissent dans le tableau de bord de l'hébergeur (Render).

# Obligatoire en ligne : active la version « production » (sert dist/ + exige la connexion).
NODE_ENV=production

# Obligatoire en ligne : ton mot de passe de connexion au CRM (choisis-en un fort).
CRM_PASSWORD=

# Obligatoire en ligne : secret pour signer les sessions (une longue chaîne aléatoire).
# Sur Render, il est généré automatiquement — sinon, invente ~40 caractères au hasard.
SESSION_SECRET=

# Obligatoire en ligne : lien de connexion à ta base MongoDB (persistance des données).
# Ex : mongodb+srv://utilisateur:motdepasse@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# Optionnel : nom de la base (par défaut « crm »).
MONGODB_DB=crm

# ---------------------------------------------------------------------------
# Rien de tout ça n'est nécessaire sur ton PC en local : sans ces variables,
# le CRM démarre sans mot de passe et enregistre dans data/crm.json comme avant.
